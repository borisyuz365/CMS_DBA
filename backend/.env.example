# Coralogix API config — used by /api/scanners/:id/logs-summary
# When CORALOGIX_API_KEY is empty/missing, the endpoint returns mock data.
# Get a key from Coralogix → Settings → API Keys with the "DataQuerying" role preset.
CORALOGIX_API_KEY=
# Full DataPrime query URL. Default is EU1 (365scores.coralogix.com is EU1).
# Other regions: https://api.us1.coralogix.com, https://api.eu2.coralogix.com,
# https://api.ap1.coralogix.in, https://api.ap2.coralogix.com.
CORALOGIX_API_URL=https://api.eu1.coralogix.com/api/v1/dataprime/query
