# Coralogix API config — used by /api/scanners/:id/logs-summary
# When CORALOGIX_API_KEY is empty/missing, the endpoint returns mock data.
CORALOGIX_API_KEY=
CORALOGIX_API_URL=https://api.eu1.coralogix.com/api/v1/dataprime/query

# BP runtime invalidate hook (local bp-service on :3002; prod: private internal URL)
BP_RUNTIME_INVALIDATE_URL=http://localhost:3002/internal/invalidate
BP_INVALIDATE_SECRET=dev-invalidate-secret

# Documented public URL for mobile clients (prod: CloudFront hostname)
# BP_RUNTIME_PUBLIC_URL=https://bp-api.365scores.com

# Public CloudFront distribution for BP runtime (prod only — not cms-dba)
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
